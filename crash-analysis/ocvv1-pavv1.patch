@@ -51,6 +61,18 @@ def decode_opencv(
     return frames, source, frame_idx, valid
 
 
+def _count_decodable_frames(data: bytes) -> int:
+    """Number of frames a sequential decode yields (follows the timeline)."""
+    counter = OpenCVVideoBackendMixin.open_video_capture(data)
+    try:
+        count = 0
+        while counter.grab():
+            count += 1
+        return count
+    finally:
+        counter.release()
+
+
 class OpenCVVideoBackendMixin:
     @staticmethod
     def get_cv2_video_api():
